#!/bin/bash
# Header law (CLAUDE.md): every tracked .mc opens with the exact 2-line
# MCode Bench(TM) provenance template. Nothing may precede it.
set -u
cd "$(dirname "$0")/.."
line1='# Copyright (c) 2026 MCode. Built with MCode Bench(TM).'
line2='# Licensed under the Apache License, Version 2.0.'
bad=0
while IFS= read -r f; do
    actual=$(head -2 "$f")
    if [ "$actual" != "$line1
$line2" ]; then
        echo "FAIL header: $f"
        bad=1
    fi
done < <(git ls-files '*.mc')
if [ "$bad" -ne 0 ]; then
    echo "pre-commit: header law violated (see CLAUDE.md)"
    exit 1
fi

# No document page/section references (CLAUDE.md): evidence trails like
# `p.27`, `pp.1/25`, `Table 5-1` live in the packs, never in this repo.
pagebad=0
while IFS= read -r f; do
    case "$f" in */libs/*|CLAUDE.md) continue ;; esac
    [ -f "$f" ] || continue
    if grep -nEi '(^|[^a-zA-Z0-9])pp?\.[ ]?[0-9]+' "$f" >/dev/null 2>&1; then
        grep -nEi '(^|[^a-zA-Z0-9])pp?\.[ ]?[0-9]+' "$f" | sed "s|^|FAIL pageref: $f:|"
        pagebad=1
    fi
done < <(git ls-files '*.mc' '*.toml' '*.md')
if [ "$pagebad" -ne 0 ]; then
    echo "pre-commit: document page references found (see CLAUDE.md)"
    exit 1
fi
